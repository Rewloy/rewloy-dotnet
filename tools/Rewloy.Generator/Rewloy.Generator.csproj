<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The generator: Rewloy's OpenAPI 3.1 document in, the C# of
    src/Rewloy/Generated/ out. It is a console tool and a library: the tests
    call ApiGenerator.Generate on the committed snapshot and compare.
    net8.0 so that it runs on any SDK from 8 up; RollForward lets a machine
    with only a newer runtime run it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Rewloy.Generator</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rewloy.Tests" />
  </ItemGroup>

</Project>
